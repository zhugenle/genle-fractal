// Port of the supplied Octane gradient node. Types0..7 use orbit U/V;
// spatial types8..10 use the selected coordinate frame.
float gradientMask(vec2 uv,vec3 world,vec3 center,vec3 ro,vec3 uu,vec3 vv,vec3 ww){vec2 p=uv-.5;float a=radians(-K0.z),c=cos(a),s=sin(a);p=mat2(c,s,-s,c)*p+.5;float m=0.,kind=K0.x;if(kind<.5)m=p.x;else if(kind<1.5)m=p.y;else if(kind<2.5)m=.5*(p.x-p.y)+.5;else if(kind<3.5){vec2 q=p-.5;q=vec2(-q.y,q.x)+.5;m=.1594*atan(.5-q.x,.5-q.y)+.5;}else if(kind<4.5)m=1.420*length(p-.5);else if(kind<5.5)m=max(2.*abs(p.x-.5),2.*abs(p.y-.5));else if(kind<6.5){vec2 corner=step(.5,p);m=1.420*length(p-corner);}else if(kind<7.5)m=0.;else{vec3 P=vec3(world.x,world.z,world.y);if(K0.y>.5&&K0.y<1.5){vec3 d=world-center;P=vec3(d.x,d.z,d.y);}else if(K0.y>2.5&&K0.y<3.5){vec3 d=world-ro;P=vec3(dot(d,uu),dot(d,vv),dot(d,ww));}else if(K0.y>3.5&&K0.y<4.5)P=vec3(gl_FragCoord.x,resolution.y-gl_FragCoord.y,0.)*(mappingResolution/resolution.y);else if(K0.y>4.5)P=vec3(gl_FragCoord.x/resolution.x,1.-gl_FragCoord.y/resolution.y,0.);vec3 start=K2.xyz,end=vec3(K2.w,K3.xy),d=P-start;if(kind<8.5){vec3 b=end-start;m=dot(b,d)/max(dot(b,b),1e-8);}else if(kind<9.5){vec3 b=end-start;m=length(cross(d,b))/max(length(b),1e-8)/max(K1.y,1e-8);}else m=length(d)/max(K1.y,1e-8);m=fract(abs(m));}m=clamp(m+2.*K1.x*(K1.z-.250),0.,1.);m=pow(m,K0.w);return K1.w>.5?1.-m:m;}


// Black studio with finite rectangular emitters. R: detail, fill, reflection gain, light size.
uniform vec4 R;
uniform vec3 LightKey;
uniform vec3 LightFill;
uniform vec3 LightRim;
uniform vec3 ColorA;
uniform vec3 ColorB;
uniform vec4 S; // specular environment fill, reflection occlusion, blue bounce, normal filter

vec3 environment(vec3 ray,float roughness){ray=rotateY(ray,radians(N.z));float blur=roughness*roughness*.8;float size=R.w;float top=pow(max(dot(ray,normalize(vec3(-.3,.75,.5))),0.),2.);float side=pow(max(dot(ray,normalize(vec3(.8,.25,.4))),0.),4.);float gradient=.2+.8*pow(.5+.5*ray.y,2.);vec3 surround=vec3(.48,.42,.31)*S.x*gradient+vec3(1.8,1.7,1.4)*LightKey*top*L.x*.13+vec3(.62,.68,.74)*LightRim*side*L.z;return surround+vec3(5.,4.8,4.1)*LightKey*card(ray,keyDirection(),size*1.25,size*2.8,blur)*L.x+vec3(.03,.48,.75)*LightFill*card(ray,normalize(vec3(-.65,.15,.9)),size*1.8,size*2.,blur)*L.y+vec3(2.6,2.7,2.8)*LightRim*card(ray,normalize(vec3(.6,.5,-.8)),size*1.2,size*2.5,blur)*L.z;}
float shadow(vec3 p,vec3 l,float e){float visibility=1.,t=e*5.;for(int j=0;j<40;j++){if(quality==0&&j>=12)break;if(quality==1&&j>=14)break;if(quality==2&&j>=22)break;float d=scene(p+l*t);if(d<e*.35)return 0.;visibility=min(visibility,8.*d/max(t,e));t+=clamp(d*.65,e*2.,.16/A.w);if(t>2.4/A.w)break;}return clamp(visibility,0.,1.);}
vec3 reflection(vec3 p,vec3 ray,float rough,float e,vec3 ro,vec3 uu,vec3 vv,vec3 ww){vec3 env=environment(ray,rough);if(quality<3||S.y<=0.)return env;float t=e*8.;for(int j=0;j<64;j++){if(quality==3&&j>=32)break;vec3 q=p+ray*t;vec2 orbitSample=evaluateFormula(q);float d=orbitSample.x;if(d<e){vec3 n=normalAt(q,e*.65);float trap=orbitSample.y;float u=coordinate(trap,I.z,I.w,q.x*A.w);float w=coordinate(trap,J.x,J.y,q.y*A.w);float mask=gradientMask(vec2(u,w),q,vec3(A.x,A.z,A.y),ro,uu,vv,ww);vec3 base=mix(ColorB,ColorA,mask);float lit=max(dot(n,keyDirection()),0.);vec3 bounce=base*(vec3(.04*R.y)+.32*L.x*lit*LightKey)+environment(reflect(ray,n),rough)*.32;return mix(env,bounce,S.y);}t+=max(d*.45,e*.5);if(t>4./A.w)return env;}return env;}
vec3 renderSample(vec2 pixel){vec2 uv=(pixel-.5*resolution)/resolution.y;vec3 center=vec3(A.x,A.z,A.y);vec3 ro=center+camera.z*vec3(cos(camera.y)*sin(camera.x),sin(camera.y),cos(camera.y)*cos(camera.x));vec3 ww=normalize(center-ro),uu=vec3(cos(camera.x),0.,-sin(camera.x)),vv=cross(uu,ww);float cr=cos(camera.w),sr=sin(camera.w);vec3 rotatedU=uu*cr+vv*sr;vv=vv*cr-uu*sr;uu=rotatedU;vec3 rd=normalize(uv.x*uu+uv.y*vv+1.7*ww);float radius=J.z/max(A.w,.0001);vec3 oc=ro-center;float b=dot(oc,rd),c=dot(oc,oc)-radius*radius,dis=b*b-c;float travel=0.,e=.0001;bool hit=false;vec2 surfaceOrbit=vec2(0.);if(dis>0.){travel=max(0.,-b-sqrt(dis));float end=-b+sqrt(dis);if(J.w>0.){float extent=min(radius,1.2/max(A.w,.0001));float plane=camera.z-extent+2.*extent*J.w;travel=max(travel,plane/max(dot(rd,ww),.0001));}for(int i=0;i<560;i++){if(travel>end)break;if(quality==0&&i>=120)break;if(quality==1&&i>=240)break;if(quality==2&&i>=320)break;if(quality==3&&i>=400)break;vec3 p=ro+rd*travel;vec2 orbitSample=evaluateFormula(p);float d=orbitSample.x;float pixelSize=travel/detailResolution;e=max(.000008/A.w,pixelSize*(quality>=3?.09:quality==2?.14:.22)*R.x);if(d<e&&(J.w<=0.||d> -e)){hit=true;surfaceOrbit=orbitSample;break;}travel+=max(abs(d)*T.w,e*.15);if(travel>end)break;}}
vec3 color=vec3(0.);if(hit){vec3 p=ro+rd*travel,n=normalAt(p,max(.0004/A.w,travel/detailResolution*S.w)),v=-rd;vec2 orbit=surfaceOrbit;float u=coordinate(orbit.y,I.z,I.w,p.x*A.w),w=coordinate(orbit.y,J.x,J.y,p.y*A.w);float mask=gradientMask(vec2(u,w),p,center,ro,uu,vv,ww);vec3 blue=ColorB,gold=ColorA;vec3 key=keyDirection(),cyan=normalize(vec3(-.65,.15,.9)),rim=normalize(vec3(.6,.5,-.8));float occ=0.,weight=1.;for(int j=0;j<7;j++){float h=(.003*pow(1.8,float(j)))/A.w;occ+=max(0.,h-scene(p+n*h))/h*weight;weight*=.58;}float ao=clamp(1.-occ*.6,0.,1.);vec3 origin=p+n*max(e*8.,.0015/A.w);float vk=1.,vc=ao,vr=ao;if(L.x>0.&&max(max(LightKey.r,LightKey.g),LightKey.b)>0.)vk=shadow(origin,key,e);if(quality>=2){if(L.y>0.&&max(max(LightFill.r,LightFill.g),LightFill.b)>0.)vc=shadow(origin,cyan,e);if(L.z>0.&&max(max(LightRim.r,LightRim.g),LightRim.b)>0.)vr=shadow(origin,rim,e);}float goldR=sqrt(MG.y*MG.y+R.w*R.w*.12),blueR=sqrt(MG.w*MG.w+R.w*R.w*.12);vec3 warm=vec3(5.5,5.2,4.5)*LightKey*L.x*vk,cool=vec3(.02,3.6,6.)*LightFill*L.y*vc,edge=vec3(2.,2.1,2.2)*LightRim*L.z*vr;vec3 goldLight=brdf(n,v,key,gold,warm,MG.x,goldR)+brdf(n,v,cyan,gold,cool,MG.x,goldR)+brdf(n,v,rim,gold,edge,MG.x,goldR);vec3 blueLight=brdf(n,v,key,blue,warm,MG.z,blueR)+brdf(n,v,cyan,blue,cool,MG.z,blueR)+brdf(n,v,rim,blue,edge,MG.z,blueR);color=mix(blueLight,goldLight,mask);if(R.z>0.){vec3 ray=reflect(-v,n);vec3 goldF=fresnel(mix(vec3(.04),gold,MG.x),max(dot(n,v),0.)),blueF=fresnel(mix(vec3(.04),blue,MG.z),max(dot(n,v),0.));vec3 reflected=reflection(origin,ray,mix(MG.w,MG.y,mask),e,ro,uu,vv,ww);color+=reflected*mix(blueF,goldF,mask)*R.z*mix(ao,1.,mask*.85);}color+=mix(blue*(1.-MG.z),gold*(1.-MG.x),mask)*R.y*.06*ao;float coat=pow(max(dot(n,normalize(key+v)),0.),200.)*M.z*.12; color+=vec3(coat)*LightKey*L.x*vk*mask;float bounceFacing=.25+.75*max(dot(n,cyan),0.);color+=blue*S.z*LightFill*L.y*bounceFacing*mix(ao,1.,.25)*(1.-mask);color+=blue*N.w*(1.-mask)*ao;}
return color;}
void main(){vec3 color=renderSample(gl_FragCoord.xy);color*=pow(2.,L.w);color=(color*(2.51*color+.03))/(color*(2.43*color+.59)+.14);color=pow(clamp(color,0.,1.),vec3(1./2.2));gl_FragColor=vec4(color,1.);}
