precision highp float;
uniform vec2 res; uniform int model; uniform float param; uniform float yaw; uniform float pitch; uniform float cameraDistance; uniform int palette; uniform int quality;
float box(vec3 p,vec3 b){vec3 q=abs(p)-b;return length(max(q,0.))+min(max(q.x,max(q.y,q.z)),0.);}
float bulb(vec3 p){vec3 z=vec3(0.);float dr=1.,r=0.;for(int i=0;i<16;i++){r=length(z);if(r>3.)break;if(r<.000001){z=p;continue;}float theta=acos(clamp(z.z/r,-1.,1.));float phi=atan(z.y,z.x);float rn=pow(r,param);dr=pow(r,param-1.)*param*dr+1.;theta*=param;phi*=param;z=rn*vec3(sin(theta)*cos(phi),sin(theta)*sin(phi),cos(theta))+p;}r=max(length(z),.000001);return .5*log(r)*r/dr;}
float menger(vec3 p){float d=box(p,vec3(1.));float scale=1.;for(int i=0;i<5;i++){if(float(i)>=param)break;vec3 a=mod(p*scale,2.)-1.;scale*=3.;vec3 r=abs(1.-3.*abs(a));float da=max(r.x,r.y),db=max(r.y,r.z),dc=max(r.z,r.x);float c=(min(da,min(db,dc))-1.)/scale;d=max(d,c);}return d;}
float tetra(vec3 p){vec3 a=vec3(1.,1.,1.),b=vec3(-1.,-1.,1.),c=vec3(-1.,1.,-1.),d=vec3(1.,-1.,-1.);float scale=1.;for(int i=0;i<7;i++){if(float(i)>=param)break;vec3 v=a;float l=dot(p-a,p-a);float t=dot(p-b,p-b);if(t<l){l=t;v=b;}t=dot(p-c,p-c);if(t<l){l=t;v=c;}t=dot(p-d,p-d);if(t<l){v=d;}p=2.*p-v;scale*=2.;}float sd=max(max(dot(p,vec3(-1.,-1.,-1.)),dot(p,vec3(1.,1.,-1.))),max(dot(p,vec3(1.,-1.,1.)),dot(p,vec3(-1.,1.,1.))));return (sd-1.)/(1.7320508*scale);}
float mandelbox(vec3 p){vec3 z=vec3(0.);float dr=0.;for(int i=0;i<16;i++){z=2.*clamp(z,-1.,1.)-z;float r2=dot(z,z);if(r2<.25){z*=4.;dr*=4.;}else if(r2<1.){z/=r2;dr/=r2;}z=param*z+p;dr=param*dr+1.;if(dot(z,z)>1024.)break;}return length(z)/max(dr,.0001);}
float julia(vec3 p){vec4 q=vec4(p,param);float dr=1.;for(int i=0;i<22;i++){float r=length(q);if(r>4.)break;dr*=max(2.*r,.0001);q=vec4(q.x*q.x-dot(q.yzw,q.yzw),2.*q.x*q.yzw)+vec4(-.2,.7,0.,0.);}float r=max(length(q),.0001);return .5*r*log(r)/max(dr,.0001);}
float scene(vec3 p){if(model==0)return bulb(p);if(model==1)return menger(p);if(model==2)return tetra(p);if(model==3)return mandelbox(p);return julia(p);}
vec3 normal(vec3 p,float e){return normalize(vec3(scene(p+vec3(e,0.,0.))-scene(p-vec3(e,0.,0.)),scene(p+vec3(0.,e,0.))-scene(p-vec3(0.,e,0.)),scene(p+vec3(0.,0.,e))-scene(p-vec3(0.,0.,e))));}
void main(){vec2 uv=(gl_FragCoord.xy-.5*res)/res.y;vec3 ro=cameraDistance*vec3(cos(pitch)*sin(yaw),sin(pitch),cos(pitch)*cos(yaw));vec3 ww=normalize(-ro),uu=normalize(cross(ww,vec3(0.,1.,0.))),vv=cross(uu,ww);vec3 rd=normalize(uv.x*uu+uv.y*vv+1.7*ww);vec3 bg=mix(vec3(.065,.09,.076),vec3(.12,.15,.12),clamp(uv.y+.6,0.,1.));float radius=model==3?40.:1.85;float b=dot(ro,rd),c=dot(ro,ro)-radius*radius,disc=b*b-c;float travel=0.;bool hit=false;float epsilon=.001;if(disc>0.){travel=max(0.,-b-sqrt(disc));float end=-b+sqrt(disc);for(int i=0;i<200;i++){if(quality==0 && i>95)break;if(quality==1 && i>145)break;vec3 pos=ro+rd*travel;float d=scene(pos);epsilon=max(.00045,travel/res.y*.42);if(d<epsilon){hit=true;break;}travel+=max(d*(model==3?.7:.8),epsilon*.4);if(travel>end)break;}}
vec3 col=bg;if(hit){vec3 p=ro+rd*travel;vec3 n=normal(p,epsilon*.75);vec3 light=normalize(vec3(-.6,1.,.8));float diff=max(dot(n,light),0.);float occ=0.;float weight=1.;for(int j=1;j<=4;j++){float h=float(j)*.025;occ+=(h-scene(p+n*h))*weight;weight*=.5;}float ao=clamp(1.-occ*5.,.22,1.);vec3 base=vec3(.49,.62,.34);if(palette==1)base=vec3(.8,.8,.7);if(palette==2)base=vec3(.7,.32,.17);base*=.91+.09*sin(p.y*5.+p.x*2.);float spec=pow(max(dot(n,normalize(light-rd)),0.),36.);float rim=pow(1.-max(dot(n,-rd),0.),3.);col=base*(.25+.85*diff)*ao+vec3(.65,.75,.46)*spec*.32+base*rim*.2;col=mix(col,bg,1.-exp(-.012*travel));}col*=max(.6,1.-.2*dot(uv,uv));col=pow(max(col,0.),vec3(.88));gl_FragColor=vec4(col,1.);}
